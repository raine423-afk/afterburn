<reactive:ReactiveUserControl
    x:TypeArguments="local:IStoragePageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactive="http://reactiveui.net"
    xmlns:local="using:NexusMods.App.UI.Pages.Storage"
    mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
    x:CompileBindings="False"
    x:Class="NexusMods.App.UI.Pages.Storage.StoragePageView">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="12" MaxWidth="1000" HorizontalAlignment="Left">

            <TextBlock Text="Storage" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding StorageSummary}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding FreeSpaceText}" TextWrapping="Wrap" Opacity="0.75" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Clean up unused files" Command="{Binding CleanupCommand}" />
                <Button Content="Open archive folder" Command="{Binding OpenArchivesFolderCommand}" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding CleanupStatus}" TextWrapping="Wrap" Opacity="0.75" />

            <Separator Margin="0,12" />

            <TextBlock Text="Files Afterburn didn't install" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding UnmanagedSummary}" TextWrapping="Wrap" />
            <TextBlock TextWrapping="Wrap" Opacity="0.75"
                       Text="If you stop backing up a folder, its files stay in your game folder and keep working, but Afterburn can't restore them if they're removed or you switch loadouts." />

            <ItemsControl ItemsSource="{Binding UnmanagedFolders}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,4">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Details}" Opacity="0.75" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding BackupStateText}" VerticalAlignment="Center" Margin="12,0" Opacity="0.75" />
                            <Button Grid.Column="2" Content="{Binding BackupButtonText}" Command="{Binding ToggleBackupCommand}" Margin="4,0" />
                            <Button Grid.Column="3" Content="Open folder" Command="{Binding OpenFolderCommand}" Margin="4,0" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</reactive:ReactiveUserControl>
