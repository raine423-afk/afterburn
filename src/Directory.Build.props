<Project>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <PropertyGroup>
        <WarningsAsErrors>Nullable</WarningsAsErrors>
    </PropertyGroup>

    <!-- Afterburn: the separate Microsoft.SourceLink.GitHub 8.0.0 package was removed (it pulls in
         Microsoft.Build.Tasks.Git 8.0.0, GHSA-23fw-v26w-5fgq). The .NET SDK includes Source Link itself. -->
</Project>
